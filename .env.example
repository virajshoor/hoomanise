APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hoomanise
REDIS_URL=redis://localhost:6379/0

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:8000

API_KEY_PREFIX=hm_

ALLOWED_ORIGINS=http://localhost:8000

PUBLIC_BASE_URL=

MAX_INPUT_CHARS=20000
MAX_BODY_BYTES=1000000

RATE_LIMIT_USER_PER_MIN=10
RATE_LIMIT_USER_PER_DAY=200
RATE_LIMIT_IP_PER_MIN=30
RATE_LIMIT_GLOBAL_PER_MIN=240

JOB_CONCURRENCY=3
JOB_QUEUE_WAIT_SECONDS=600
JOB_SLOT_TTL_SECONDS=120
JOB_RESULT_TTL_HOURS=24

DB_POOL_MIN=1
DB_POOL_MAX=3
REDIS_POOL_MAX=10

FREE_CREDITS_DEFAULT=600
WORDS_PER_CREDIT=5
SALES_EMAIL=support@example.com
PUBLIC_SITE_URL=http://localhost:8000
USE_SPACY_GRAMMAR=true
LOG_FORMAT=text
LOG_SAMPLE=1.0
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_HOURS=168
RATE_LIMIT_BATCH_MAX=10
WEBHOOK_DELIVERY_RETRIES=3
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_PER_USER=5

# Generate a random value before starting the API.
API_KEY_PEPPER=""
